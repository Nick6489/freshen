#include <windows.h>
#include <commctrl.h>

1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
 FILEVERSION @MAJOR@,@MINOR@,@PATCH@,0
 PRODUCTVERSION @MAJOR@,@MINOR@,@PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Freshen Native Test"
   VALUE "FileVersion", "@VERSION@"
   VALUE "ProductName", "Freshen Native Test"
   VALUE "ProductVersion", "@VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

101 DIALOGEX 0, 0, 330, 218
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Freshen Native Test"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Freshen Native Test", -1, 12, 10, 300, 14
 LTEXT "Version", 1001, 12, 28, 300, 12
 LTEXT "This disposable app exercises installing a signed test update.", -1, 12, 46, 304, 20
 LTEXT "&Test text (not saved):", -1, 12, 71, 300, 12
 EDITTEXT 1002, 12, 85, 306, 16, ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "&Status:", -1, 12, 110, 300, 12
 EDITTEXT 1003, 12, 124, 306, 42, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
 DEFPUSHBUTTON "&Check for updates", 1004, 12, 185, 100, 22, WS_TABSTOP
 PUSHBUTTON "&Install update", 1005, 119, 185, 95, 22, WS_TABSTOP | WS_DISABLED
 PUSHBUTTON "E&xit", IDCANCEL, 222, 185, 96, 22, WS_TABSTOP
END

102 DIALOGEX 0, 0, 330, 177
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Freshen Native Test - Update"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Updating Freshen Native Test", -1, 12, 10, 305, 14
 LTEXT "&Status:", -1, 12, 34, 300, 12
 EDITTEXT 1003, 12, 48, 306, 42, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
 LTEXT "Installation &work:", -1, 12, 99, 300, 12
 CONTROL "Installation work", 1006, PROGRESS_CLASS, WS_CHILD | WS_VISIBLE | PBS_MARQUEE, 12, 114, 306, 13
 DEFPUSHBUTTON "&Open updated app", 1007, 100, 143, 116, 22, WS_TABSTOP | WS_DISABLED
 PUSHBUTTON "&Close", IDCANCEL, 222, 143, 96, 22, WS_TABSTOP | WS_DISABLED
END
